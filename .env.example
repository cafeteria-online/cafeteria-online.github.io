# Copia este archivo como .env y llena los valores de tu proyecto Supabase
# (botón Connect del proyecto, o Settings > API Keys). La clave publicable
# (sb_publishable_...) es pública por diseño; la clave secreta (sb_secret_...)
# NUNCA debe ir aquí ni en el repositorio.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
